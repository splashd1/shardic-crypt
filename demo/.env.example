# Copy this to .env before running docker-compose:
#   cp .env.example .env
#
# Every value below is a fixed, intentionally-insecure demo credential --
# the trustee passwords and the combiner client secret must match what's
# baked into keycloak/realm-export.json verbatim (they are not randomly
# generated per environment). This is fine for a throwaway local demo;
# none of this is a pattern to reuse for anything real.

# Keycloak's own bootstrap admin (master realm / admin console login).
# Not related to the demo realm's 7 trustee users.
KEYCLOAK_ADMIN_PASSWORD=admin-demo-pw1

# Must match the "secret" field of the shardic-combiner-admin client in
# keycloak/realm-export.json.
ADMIN_CLIENT_SECRET=combiner-admin-demo-secret1

# Must match the demo "operator" user's password in
# keycloak/realm-export.json. The operator authenticates to Keycloak
# (Direct Access Grant, same demo shortcut as the trustee passwords
# below) and must hold the shardic-operator realm role for /admin/*
# routes to accept the resulting Bearer token -- see README.md.
OPERATOR_PASSWORD=operator-demo-pw1

# Must match each user's "credentials" password value in
# keycloak/realm-export.json.
TRUSTEE_PASSWORD_ALICE=alice-demo-pw1
TRUSTEE_PASSWORD_BOB=bob-demo-pw1
TRUSTEE_PASSWORD_CAROL=carol-demo-pw1
TRUSTEE_PASSWORD_DAVE=dave-demo-pw1
TRUSTEE_PASSWORD_ERIN=erin-demo-pw1
TRUSTEE_PASSWORD_FRANK=frank-demo-pw1
TRUSTEE_PASSWORD_GRACE=grace-demo-pw1

# Notification channels (docs/notification-channels.md) -- optional,
# all unset by default. log_line needs nothing and is always on
# regardless of these.
#
# NOTE: unlike everything else in this file, NOTIFY_EMAIL_APP_PASSWORD
# is a REAL credential if you fill it in (a Gmail app password), not a
# throwaway demo secret -- never commit a real value here. Fill it into
# your local .env only, which is gitignored.
NOTIFY_CEREMONY_INVITE_CHANNELS=log_line
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_SMTP_HOST=smtp.gmail.com
NOTIFY_EMAIL_SMTP_PORT=587
NOTIFY_EMAIL_USERNAME=
NOTIFY_EMAIL_APP_PASSWORD=
NOTIFY_EMAIL_BASE_ADDRESS=
